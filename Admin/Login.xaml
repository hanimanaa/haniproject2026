<Window x:Class="WpfHobbies.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfHobbies"
        mc:Ignorable="d"
        Title="Login" Height="600" Width="600" WindowStartupLocation="CenterScreen">
    <Grid Background="AliceBlue" FlowDirection="RightToLeft" >
        <Grid.RowDefinitions>
            <RowDefinition Height="*" ></RowDefinition>
            <RowDefinition Height="*" ></RowDefinition>
            <RowDefinition Height="*" ></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*" ></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="3*"></ColumnDefinition>
            <ColumnDefinition Width="4*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Label Content="Login" Grid.Column="1" Grid.Row="0" FontSize="40" Grid.ColumnSpan="2"  HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Snap ITC"/>
        <TextBlock Grid.Column="1"  Grid.Row="1" HorizontalAlignment="Right"   Text="דואר אלקטרוני" VerticalAlignment="Center" FontSize="30" Margin="0,0,10,0" />
        <TextBox x:Name="EmailBox" Grid.Column="2"  Grid.Row="1" HorizontalAlignment="Left" Height="35"   Text="" VerticalAlignment="Center" FontSize="23" Width="200"  Margin="10,0,0,0" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"/>
        <TextBlock Grid.Column="1"  Grid.Row="2" HorizontalAlignment="Right"   Text="סיסמה" VerticalAlignment="Center" FontSize="30" Margin="0,0,10,0" />
        <PasswordBox x:Name="PassBox"  Grid.Column="2"  Grid.Row="2" HorizontalAlignment="Left" Height="35"    VerticalAlignment="Center" FontSize="30" Width="200"  Margin="10,0,0,0" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"/>
        <Button x:Name="LoginBtn" Content="כניסה" Grid.Column="1" HorizontalAlignment="Center"  Grid.Row="3" VerticalAlignment="Center" Width="75" Grid.ColumnSpan="2" FontSize="24" Click="LoginBtn_Click"/>
        <Image Grid.Column="1"  Grid.Row="4" Grid.ColumnSpan="2" Grid.RowSpan="2" Height="150"   Width="150" Source="/images/LoginIcon.png"/>
       
        <Button x:Name="hint" Grid.Column="2" HorizontalAlignment="Left" Height="35" Margin="89,30,0,0" Grid.Row="3" VerticalAlignment="Top" Width="34" BorderBrush="{x:Null}" Click="hint_Click" >
            <Button.Background>
                <ImageBrush ImageSource="/images/sign.png" Stretch="UniformToFill"/>
            </Button.Background>
        </Button>
    </Grid>
</Window>
