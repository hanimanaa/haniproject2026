<Page x:Class="WpfHobbies.Users"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfHobbies"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Users">

    <Grid FlowDirection="RightToLeft">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" ></RowDefinition>
            <RowDefinition Height="5*" ></RowDefinition>
            <RowDefinition Height="*" ></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Label Content="משתמשים" Grid.Column="0" Grid.Row="0" FontSize="40" Grid.ColumnSpan="3"  HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Aharoni" />
        <StackPanel x:Name="Buttons" Grid.Column="1" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft" Margin="5,5"  >
            <Button x:Name="AddBtn" Width="60"  Height="60" Foreground="Coral" FontSize="16" FontWeight="Bold" Margin="20,0,0,0"   Click="AddBtn_Click">
                <StackPanel>
                    <Image Source="images/adduser.png"  />                   
                </StackPanel>
            </Button>
            <Button x:Name="SearchBtn" Width="60"  Height="60" Foreground="Coral" FontSize="16" FontWeight="Bold" Margin="20,0,0,0"  Click="SearchBtn_Click">
                <StackPanel>
                    <Image Source="images/usersearch.png"  />
                </StackPanel>
            </Button>          
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="UsersDG" AutoGenerateColumns="False" CanUserAddRows="False"  ColumnWidth="*"
                  IsReadOnly="True" Background="BlanchedAlmond" Margin="5" IsSynchronizedWithCurrentItem="True" SelectionChanged="UsersDG_SelectionChanged"  >

            <DataGrid.Columns>
                <!-- data -->
                <DataGridTextColumn Header="דואר אלקטרוני" Width="120" Binding="{Binding userEmail}"/>
                <DataGridTextColumn Header="סיסמה" Binding="{Binding userPassword}"/>
                <DataGridTextColumn Header="שם פרטי" Binding="{Binding fName}"/>
                <DataGridTextColumn Header="שם משפחה" Binding="{Binding lName}"/>
                <DataGridTextColumn Header="תאריך לידה" Binding="{Binding birthday, StringFormat=\{0:dd/MM/yyyy\}}"/>
                <DataGridTextColumn Header="מין" Binding="{Binding gender}"/>
                <DataGridTextColumn Header="טלפון" Binding="{Binding tel}"/>
                <DataGridTextColumn Header="עיר" Binding="{Binding city.cityName}"/>
                <DataGridTextColumn Header="מקבל הודעות" Binding="{Binding message}"/>
             
            </DataGrid.Columns>

        </DataGrid>

        <Frame x:Name="SubFrame" Grid.Column="1" Grid.Row="1" Source="SubUser/SubUserUpdateDelete.xaml" />
        <TextBlock x:Name="CountUsersTB" HorizontalAlignment="Left" Margin="52,19,0,0" Grid.Row="2" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top"/>



    </Grid>
</Page>
